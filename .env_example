# ---------------------------------------------------------------------------
# EuroClaw environment configuration (copy to .env)
# ---------------------------------------------------------------------------

# --- Core ---
EUROCLAW_ENV=production
EXECUTION_MODE=local           # local | distributed
SANDBOX_BACKEND=subprocess     # subprocess (default) | firecracker (KVM host)

# --- Sovereign LLM (Ollama-compatible) ---
EUROCLAW_MODEL=qwen2.5:7b
LOCAL_LLM_ENDPOINT=http://localhost:11434

# --- Redis (required for distributed mode & multi-replica state) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_TLS=false
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Telemetry (OpenTelemetry is ON by default; leave endpoint blank for local-only) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SDK_DISABLED=true       # uncomment to fully disable tracing

# --- Identity & SSO (Keycloak / Entra ID) ---
OIDC_ISSUER_URL=http://localhost:8085/realms/euroclaw
OIDC_AUDIENCE=euroclaw-api
JWKS_CACHE_TTL_SECONDS=600

# --- RBAC (optional override): "tool:role1|role2;other_tool:role3" ---
# RBAC_POLICY=send_external_email:operator;execute_bash:developer

# --- API ---
API_VERSION=v1
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Orchestration limits (bound the agent loop) ---
MAX_TOOL_ITERATIONS=5
MAX_AGENT_TURNS=6
HITL_TIMEOUT_SECONDS=300

# --- Firecracker MicroVM (only when SANDBOX_BACKEND=firecracker) ---
FC_KERNEL_PATH=/opt/euroclaw/vmlinux
FC_ROOTFS_PATH=/opt/euroclaw/rootfs.ext4
FC_BINARY=/usr/bin/firecracker
FC_VCPUS=1
FC_MEM_MIB=256
FC_GUEST_PORT=5252

# --- File workspace allowlist (comma-separated absolute paths) ---
ALLOWED_WORKSPACES=./docs

# --- Tool integrations ---
EXTERNAL_WEBHOOK_URL=https://api.yourservice.com/v1/notify
EXTERNAL_WEBHOOK_API_KEY=your-secure-api-key-here
DATABASE_URL=postgresql://localhost/mydb

# --- Messaging plugins ---
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id
TELEGRAM_BOT_TOKEN=your_telegram_token
TEAMS_APP_ID=your-microsoft-app-id
TEAMS_APP_PASSWORD=your-microsoft-app-client-secret
EUROCLAW_EMAIL=ai-agent@yourdomain.com
EUROCLAW_EMAIL_PASSWORD=secure_app_password
EUROCLAW_IMAP_SERVER=imap.yourdomain.com
EUROCLAW_SMTP_SERVER=smtp.yourdomain.com
